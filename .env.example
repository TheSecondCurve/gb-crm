# gb-crm 环境变量（复制为 .env 后按需填写；.env 永不提交）

# development / production；production 时关 CORS、建议开 Secure
NODE_ENV=development

# 监听地址；内网 Compose 内用 0.0.0.0；非 loopback 且 COOKIE_SECURE 非 true 时启动仅 warn
HOST=127.0.0.1

PORT=3001

# SQLite 文件路径；相对路径锚定仓库根（本地 → <root>/data/，Docker 用绝对路径 /data/）；创建后进程会 chmod 600
DATABASE_PATH=./data/gb-crm.sqlite

# 【必填】≥32 字符，cookie 签名（HMAC）密钥
SESSION_SECRET=

# HTTPS 前置（如内网 Caddy）时设为 true
COOKIE_SECURE=false

# 仅在反代（Caddy 等）之后设为 true；未信任代理时绝不读 X-Forwarded-For
TRUST_PROXY=false

# 零 live admin 时必填：bootstrap 管理员用户名
ADMIN_USERNAME=

# 创建或 reset 管理员密码时必填；已有 live admin 可省略
ADMIN_PASSWORD=

# 禁止长期为 true；true 且 ADMIN_PASSWORD 为空 → 拒绝启动
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# 仅开发用 CORS 来源（Vite dev server）
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# 生产静态资源目录；默认按仓库布局取 apps/web/dist，Docker 等布局不同场景才需覆盖
# WEB_DIST=
