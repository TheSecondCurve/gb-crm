# gb-crm 生产机密（docker-compose.yml 的 env_file；复制为 .env.production 后填写，.env.production 永不提交）

# 【必填】≥32 字符，cookie 签名（HMAC）密钥
SESSION_SECRET=

# 首次启动（零 live admin）必填：bootstrap 管理员用户名/密码；已有 live admin 后 ADMIN_PASSWORD 可删除
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 禁止长期为 true；true 且 ADMIN_PASSWORD 为空 → 拒绝启动
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

# K52 定时任务 cron 按进程本地时区求值：生产容器请设 TZ=Asia/Shanghai，否则 cron 按 UTC 偏移 8 小时
TZ=Asia/Shanghai
